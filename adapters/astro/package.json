{
  "name": "astro-pail",
  "version": "0.1.0",
  "description": "Deploy an Astro site to Pail: prerendered pages as files, on-demand pages and API routes as a function.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chrisdmacrae/pail.git",
    "directory": "adapters/astro"
  },
  "keywords": [
    "astro-adapter",
    "withastro",
    "pail"
  ],
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./server.js": "./src/server.js",
    "./preview.js": "./src/preview.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "lint": "biome check",
    "format": "biome check --write"
  },
  "peerDependencies": {
    "astro": "^7.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "astro": "^7.3.5"
  }
}
