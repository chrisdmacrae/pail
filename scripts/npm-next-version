#!/usr/bin/env node
// Prints the version to publish an npm package as, so that every push can
// release without anyone touching its package.json.
//
// The version in package.json is used the first time. Once that one is on
// npm, each release after it is the next patch: 0.1.0, 0.1.1, 0.1.2. To start
// a new minor or major, change package.json; its version is used as it is.
//
// Usage: scripts/npm-next-version <package folder>
const { execFileSync } = require('node:child_process');
const path = require('node:path');

const dir = process.argv[2];
if (!dir) {
  console.error('usage: scripts/npm-next-version <package folder>');
  process.exit(2);
}
const { name, version } = require(path.resolve(dir, 'package.json'));

// A package npm has never heard of has no versions, and that isn't a failure.
let published = [];
try {
  const out = execFileSync('npm', ['view', name, 'versions', '--json'], { stdio: ['ignore', 'pipe', 'pipe'] });
  published = [].concat(JSON.parse(out.toString() || '[]'));
} catch (err) {
  if (!`${err.stdout}${err.stderr}`.includes('E404')) {
    console.error(`npm couldn't say which versions of ${name} are published:\n${err.stderr}`);
    process.exit(1);
  }
}

if (!published.includes(version)) {
  console.log(version);
  process.exit(0);
}
const [major, minor] = version.split('.');
const patches = published
  .map((v) => /^(\d+)\.(\d+)\.(\d+)$/.exec(v))
  .filter((m) => m && m[1] === major && m[2] === minor)
  .map((m) => Number(m[3]));
console.log(`${major}.${minor}.${Math.max(...patches) + 1}`);
