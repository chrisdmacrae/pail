---
import { getCollection } from 'astro:content';
import '../../../web/design-system/tokens.css';
import '../../../web/design-system/components/bundle.css';
import '../styles/docs.css';
import Search from '../components/Search.astro';

interface Props {
  title: string;
  description: string;
  // section is drawn above the title in the page's social image.
  section?: string;
  // headings are the page's own, for the list of what is on it.
  headings?: { depth: number; slug: string; text: string }[];
  // wide lets the page use the room the list of headings would take.
  wide?: boolean;
}
const { title, description, section, headings = [], wide = false } = Astro.props;

// On this page: the headings a page is divided by, and the ones under them.
// A page with one heading or none has nothing to choose between.
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const hasToc = !wide && toc.length > 1;

// The picture a link to this page unfurls with is drawn on demand by
// src/pages/api/og.png.ts, from what the address says. Whatever reads the tag
// wants a whole address, which takes `site` in astro.config.mjs.
const picture = `/api/og.png?${new URLSearchParams({ title, lead: description, ...(section && { section }) })}`;
const absolute = (path: string) => (Astro.site ? new URL(path, Astro.site).href : path);

// The sidebar is the collection, two levels deep: sections in a fixed order,
// and their pages by order. A provider's guide isn't listed; it is reached
// from the tiles on its section's first page, which the sidebar marks while
// the guide is open.
const all = await getCollection('docs');
const pages = all.filter((p) => !p.data.provider).sort((a, b) => a.data.order - b.data.order);
const sections = ['Start here', 'Running Pail', 'Deploying', 'Git providers', 'Custom domains'].map((name) => ({
  name,
  pages: pages.filter((p) => p.data.section === name),
}));
const href = (id: string) => `/${id}/`;
const here = Astro.url.pathname.replace(/\/?$/, '/');
const guide = all.find((p) => p.data.provider && href(p.id) === here);
const current = guide ? href(pages.find((p) => p.data.section === guide.data.section)?.id ?? guide.id) : here;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="Pail docs" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {Astro.site && <meta property="og:url" content={absolute(Astro.url.pathname)} />}
    <meta property="og:image" content={absolute(picture)} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${title}. ${description}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title === 'Pail docs' ? title : `${title} · Pail docs`}</title>
    <script is:inline>
      // Day or Night follows the device, set before the page paints.
      (function () {
        var night = window.matchMedia('(prefers-color-scheme: dark)');
        function apply() {
          document.documentElement.dataset.theme = night.matches ? 'dark' : 'light';
        }
        apply();
        night.addEventListener('change', apply);
      })();
    </script>
  </head>
  <body>
    <header class="pa-top">
      <a class="pa-top-brand dx-home" href="/" aria-label="Pail docs, home">
        <svg class="pa-mark" width="28" height="28" viewBox="0 0 32 32" aria-hidden="true">
          <path class="pa-mark-fill" d="M7.4 17.5h17.2l-1.35 8.3H8.75z"></path>
          <g fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round">
            <path d="M8.5 12.5a7.5 7.5 0 0 1 15 0"></path>
            <path d="M4.5 12.5h23M6.3 12.5l2.1 13.4a1.6 1.6 0 0 0 1.6 1.4h12a1.6 1.6 0 0 0 1.6-1.4l2.1-13.4"></path>
          </g>
        </svg>
        <span class="pa-top-word">pail</span>
        <span class="pa-top-host">docs</span>
      </a>
      <Search />
    </header>

    <div class:list={['dx-shell', hasToc && 'dx-shell-toc', wide && 'dx-shell-wide']}>
      <nav class="dx-nav" aria-label="Docs">
        {
          sections.map((section) => (
            <div class="dx-nav-group">
              <p class="dx-nav-title">{section.name}</p>
              {section.pages.map((p) => (
                <a href={href(p.id)} aria-current={current !== href(p.id) ? undefined : guide ? 'true' : 'page'}>
                  {p.data.navLabel ?? p.data.title}
                </a>
              ))}
            </div>
          ))
        }
      </nav>

      <main class:list={['dx-main', wide && 'dx-main-wide']} id="top">
        <slot />
      </main>

      {
        hasToc && (
          <nav class="dx-toc" aria-label="On this page">
            <p class="dx-nav-title">On this page</p>
            <a href="#top">Overview</a>
            {toc.map((h) => (
              <a href={`#${h.slug}`} class={h.depth === 3 ? 'dx-toc-sub' : undefined}>
                {h.text}
              </a>
            ))}
          </nav>
        )
      }
    </div>

    <script>
      // On this page marks the heading you are at: the last one to have
      // passed the line a jump to a heading lands on, just under the header.
      const toc = document.querySelector('.dx-toc');
      if (toc) {
        const links = [...toc.querySelectorAll('a')];
        const targets = links.map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1))));
        const line = 64 + 24 + 8;
        let waiting = false;
        const mark = () => {
          waiting = false;
          let at = 0;
          targets.forEach((target, i) => {
            if (i > 0 && target && target.getBoundingClientRect().top <= line) at = i;
          });
          // The last heading may sit too low ever to reach the line: at the
          // foot of the page it is where you are.
          const foot = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;
          if (foot && window.scrollY > 0) at = links.length - 1;
          links.forEach((a, i) => {
            if (i === at) a.setAttribute('aria-current', 'true');
            else a.removeAttribute('aria-current');
          });
        };
        const soon = () => {
          if (waiting) return;
          waiting = true;
          requestAnimationFrame(mark);
        };
        window.addEventListener('scroll', soon, { passive: true });
        window.addEventListener('resize', soon);
        mark();
      }
    </script>

    <script>
      // Every code block gets a Copy button, like the design system's
      // Command: it flips to "Copied" for 1.6 seconds.
      const ICONS = {
        copy: '<rect x="9" y="9" width="11" height="11" rx="2"/><path d="M15 9V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h3"/>',
        check: '<path d="m5 12.5 4.5 4.5L19 7.5"/>',
      };
      const icon = (name: keyof typeof ICONS) =>
        `<svg class="pa-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${ICONS[name]}</svg>`;

      for (const pre of document.querySelectorAll<HTMLPreElement>('.dx-main pre')) {
        const wrap = document.createElement('div');
        wrap.className = 'dx-code';
        pre.replaceWith(wrap);
        wrap.append(pre);

        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'pa-cmd-copy';
        const show = (copied: boolean) => {
          button.innerHTML = `${icon(copied ? 'check' : 'copy')}<span>${copied ? 'Copied' : 'Copy'}</span>`;
          button.setAttribute('aria-label', copied ? 'Copied' : 'Copy');
        };
        show(false);
        button.addEventListener('click', () => {
          navigator.clipboard?.writeText(pre.textContent?.trimEnd() ?? '');
          show(true);
          window.setTimeout(() => show(false), 1600);
        });
        wrap.append(button);
      }
    </script>
  </body>
</html>
